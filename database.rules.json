{
  "rules": {
    "users": {
      ".read": true,
      ".indexOn": ["wins", "soloWins", "rating/board"],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChild('name')",
        "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12" },
        "wins": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= (data.exists() ? data.val() : 0) + 1" },
        "matches": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= (data.exists() ? data.val() : 0) + 1" },
        "soloWins": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= (data.exists() ? data.val() : 0) + 1" },
        "soloMatches": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= (data.exists() ? data.val() : 0) + 1" },
        "rounds": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= (data.exists() ? data.val() : 0) + 7" },
        "color": { ".validate": "newData.isString() && newData.val().matches(/^(crimson|ion|solar|venom|violet|platinum)$/)" },
        "rating": {
          ".validate": "newData.hasChildren(['r', 'rd', 'vol', 'n', 'season', 'updated'])",
          "r": { ".validate": "newData.isNumber() && newData.val() >= 100 && newData.val() <= 3999 && (!data.exists() || (newData.val() - data.val() <= 700 && data.val() - newData.val() <= 700))" },
          "rd": { ".validate": "newData.isNumber() && newData.val() >= 30 && newData.val() <= 350" },
          "vol": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 0.2" },
          "n": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= (data.exists() ? data.val() : 0) + 1 && newData.val() % 1 === 0" },
          "season": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-Q[1-4]$/)" },
          "updated": { ".validate": "newData.isNumber() && newData.val() <= now + 86400000" },
          "board": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-Q[1-4]:[0-9]{4}$/) && newData.val().beginsWith(newData.parent().child('season').val() + ':') && newData.parent().child('n').val() >= 5" },
          "$other": { ".validate": false }
        },
        "seasons": {
          "$season": {
            ".validate": "$season.matches(/^[0-9]{4}-Q[1-4]$/)",
            "matches": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= (data.exists() ? data.val() : 0) + 1" },
            "wins": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= (data.exists() ? data.val() : 0) + 1" },
            "soloMatches": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= (data.exists() ? data.val() : 0) + 1" },
            "soloWins": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= (data.exists() ? data.val() : 0) + 1" },
            "roundsWon": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= (data.exists() ? data.val() : 0) + 7" },
            "roundsPlayed": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= (data.exists() ? data.val() : 0) + 64" },
            "diffN": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= (data.exists() ? data.val() : 0) + 1" },
            "diffSum": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= (data.exists() ? data.val() : 0) + 2" },
            "r": { ".validate": "newData.isNumber() && newData.val() >= 100 && newData.val() <= 3999" },
            "rd": { ".validate": "newData.isNumber() && newData.val() >= 30 && newData.val() <= 350" },
            "n": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= (data.exists() ? data.val() : 0) + 1" },
            "peak": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3999" },
            "style": {
              "n": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= (data.exists() ? data.val() : 0) + 1" },
              "rounds": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= (data.exists() ? data.val() : 0) + 64" },
              "trapped": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= (data.exists() ? data.val() : 0) + 40" },
              "survivalSec": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= (data.exists() ? data.val() : 0) + 3600" },
              "boostSec": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= (data.exists() ? data.val() : 0) + 3600" },
              "closePasses": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= (data.exists() ? data.val() : 0) + 500" },
              "ownWall": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= (data.exists() ? data.val() : 0) + 64" },
              "$other": { ".validate": false }
            },
            "$other": { ".validate": false }
          }
        },
        "signature": {
          ".validate": "newData.hasChildren(['hex', 'name', 'season', 'revealedAt']) && (newData.parent().child('rating/n').val() >= 5 || (data.child('hex').val() === newData.child('hex').val() && data.child('season').val() === newData.child('season').val()))",
          "hex": { ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-f]{6}$/)" },
          "name": { ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 32 && newData.val().matches(/^[A-Za-z][A-Za-z' -]*$/)" },
          "season": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-Q[1-4]$/)" },
          "revealedAt": { ".validate": "newData.isNumber() && newData.val() <= now + 86400000" },
          "$other": { ".validate": false }
        },
        "accent": {
          ".validate": "newData.hasChildren(['hex'])",
          "hex": { ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-f]{6}$/)" },
          "$other": { ".validate": false }
        },
        "$other": { ".validate": false }
      }
    },
    "logs": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        "$id": {
          ".validate": "newData.hasChildren(['t', 'mode', 'ev', 'steer', 'won'])",
          "t": { ".validate": "newData.isNumber() && newData.val() <= now + 86400000" },
          "mode": { ".validate": "newData.isString() && newData.val().matches(/^(solo|host|guest)$/)" },
          "ev": { ".validate": "newData.isString() && newData.val().matches(/^(arena|circuit)$/)" },
          "steer": { ".validate": "newData.isString() && newData.val().matches(/^(grid|free)$/)" },
          "diff": { ".validate": "newData.isString() && newData.val().matches(/^(rookie|rider|legend)$/)" },
          "bots": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 6" },
          "humans": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 6" },
          "win": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9" },
          "rounds": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99" },
          "rw": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9" },
          "won": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1" },
          "place": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 6" },
          "craft": { ".validate": "newData.isString() && newData.val().matches(/^(gt|xenoth)$/)" },
          "dOwn": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99" },
          "dRival": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99" },
          "dWall": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99" },
          "dOther": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99" },
          "dur": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 36000" },
          "fps": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000" },
          "slow": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
          "q": { ".validate": "newData.isString() && newData.val().matches(/^(low|medium|high)$/)" },
          "dpr": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 8" },
          "gap": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 600000" },
          "gap95": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 600000" },
          "rtt": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 600000" },
          "dev": { ".validate": "newData.isString() && newData.val().matches(/^(mac|ios|win|android|linux|other)$/)" },
          "br": { ".validate": "newData.isString() && newData.val().matches(/^(chrome|safari|firefox|edge|app|other)$/)" },
          "$other": { ".validate": false }
        }
      }
    },
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && $code.matches(/^[A-HJ-NP-Z2-9]{5}$/) && ((!data.exists() && newData.child('host').val() === auth.uid) || data.child('host').val() === auth.uid)",
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && data.parent().parent().child('host').exists() && (data.exists() || !newData.exists() || data.parent().parent().child('status').val() === 'lobby')",
            ".validate": "newData.hasChildren(['name', 't']) && newData.child('name').isString() && newData.child('name').val().length <= 12",
            "color": { ".validate": "newData.isString() && newData.val().matches(/^(crimson|ion|solar|venom|violet|platinum)$/)" }
          }
        },
        "in": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && data.parent().parent().child('host').exists()"
          }
        }
      }
    }
  }
}
