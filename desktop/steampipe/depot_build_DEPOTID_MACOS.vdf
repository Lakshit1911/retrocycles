// macOS depot (universal: Intel + Apple Silicon). Copy to depot_build_<depot id>.vdf.
// Steam launch option: executable "Phantom Run.app", OS macOS.
// Upload a signed + notarized build (see desktop/README.md), or Gatekeeper blocks the game.
"DepotBuild"
{
	"DepotID"	"<DEPOT_ID_MACOS>"
	"ContentRoot"	"../dist/mac-universal/"
	"FileMapping"
	{
		"LocalPath"	"Phantom Run.app/*"
		"DepotPath"	"Phantom Run.app/"
		"Recursive"	"1"
	}
}
